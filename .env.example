# Copy to .env and adjust. TalentLens never writes this file.

# Folder containing the resumes (read-only for existing files; uploads are added here)
TALENTLENS_CV_DIR=C:\Users\<you>\OneDrive\Desktop\CVs\files

# Optional read-only provenance CSV (columns: file, sha256, ...)
TALENTLENS_CV_INDEX_CSV=C:\Users\<you>\OneDrive\Desktop\CVs\cv_index.csv

# App state: SQLite DB, embeddings, model cache, logs (keep it OUT of OneDrive)
# TALENTLENS_DATA_DIR=%LOCALAPPDATA%\TalentLens

TALENTLENS_HOST=127.0.0.1
TALENTLENS_PORT=8765

# Local LLM via Ollama: "ollama" | "off" (rules only) | "mock" (tests)
TALENTLENS_LLM=ollama
TALENTLENS_OLLAMA_URL=http://127.0.0.1:11434
TALENTLENS_OLLAMA_MODEL=qwen2.5:3b-instruct

TALENTLENS_EMBED_MODEL=BAAI/bge-small-en-v1.5
TALENTLENS_RERANK_MODEL=BAAI/bge-reranker-base
TALENTLENS_MAX_UPLOAD_MB=20
