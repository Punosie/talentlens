# OPTIONAL. Most people never need a .env: choose the resume folder and AI options inside the app
# (Settings). Those choices are saved in TalentLens's own settings.json, not here.
# Copy to .env only for advanced overrides. TalentLens never writes this file.
# Anything set here takes priority over the app's Settings page (which then shows it as locked).

# Resume folder. Uncommenting this LOCKS the folder (it can't be changed in the app).
# TALENTLENS_CV_DIR=C:\Users\<you>\OneDrive\Desktop\CVs\files      (Windows)
# TALENTLENS_CV_DIR=/Users/<you>/Desktop/CVs                        (macOS)

# Optional read-only provenance CSV (default: cv_index.csv next to the resume folder)
# TALENTLENS_CV_INDEX_CSV=

# App data: databases, model cache, logs. Keep it OUT of OneDrive/iCloud.
# Default: %LOCALAPPDATA%\TalentLens (Windows), ~/Library/Application Support/TalentLens (macOS)
# TALENTLENS_DATA_DIR=

# TALENTLENS_PORT=8765

# Local AI via Ollama: "ollama" | "off" (rules only) | "mock" (tests). Setting it here locks it.
# TALENTLENS_LLM=ollama
# TALENTLENS_OLLAMA_URL=http://127.0.0.1:11434
# TALENTLENS_OLLAMA_MODEL=qwen2.5:3b-instruct

# TALENTLENS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# TALENTLENS_RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en
# TALENTLENS_MAX_UPLOAD_MB=20
