# Normalise line endings in the repo; check out LF everywhere except Windows scripts
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.docx  binary
*.doc   binary

# Lockfiles: don't diff noise in reviews
uv.lock            linguist-generated=true -diff
package-lock.json  linguist-generated=true -diff
